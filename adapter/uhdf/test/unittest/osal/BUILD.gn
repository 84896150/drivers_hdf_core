BASE_ROOT_PATH = "./../../../../../../.."
CORE_PATH = "./../../../../.."

import("$BASE_ROOT_PATH/build/lite/config/test.gni")

unittest("hdf_adapter_uhdf_test_osal") {
  output_extension = "bin"
  output_dir = "$root_out_dir/test/unittest/hdf"
  include_dirs = [
    "$BASE_ROOT_PATH/third_party/googletest/googletest/include",
    "$BASE_ROOT_PATH/third_party/bounds_checking_function/include",
    "$CORE_PATH/framework/include/platform",
    "$CORE_PATH/framework/include/core",
    "$CORE_PATH/framework/include/osal",
    "$CORE_PATH/adapter/uhdf/posix/include",
    "$CORE_PATH/framework/include/utils",
    "$CORE_PATH/framework/include",
    "$CORE_PATH/framework/test/unittest/include",
    "$CORE_PATH/framework/test/unittest/osal",
    "$BASE_ROOT_PATH/base/hiviewdfx/hilog_lite/interfaces/native/innerkits",
  ]

  defines = [ "__USER__" ]
  sources = [ "$CORE_PATH/framework/support/posix/test/unittest/common/hdf_osal_test.cpp" ]
  deps = [
    "$BASE_ROOT_PATH/base/hiviewdfx/hilog_lite/frameworks/featured:hilog_shared",
    "$CORE_PATH/adapter/build/test_common:libhdf_test_common",
    "$CORE_PATH/adapter/uhdf/manager:hdf_core",
    "$CORE_PATH/adapter/uhdf/posix:hdf_posix_osal",
  ]
  public_deps = [ "$BASE_ROOT_PATH/third_party/bounds_checking_function:libsec_shared" ]
}

unittest("hdf_adapter_uhdf_test_osal_posix") {
  output_extension = "bin"
  output_dir = "$root_out_dir/test/unittest/hdf"
  include_dirs = [
    "$BASE_ROOT_PATH/third_party/googletest/googletest/include",
    "$BASE_ROOT_PATH/third_party/bounds_checking_function/include",
    "$CORE_PATH/framework/include/platform",
    "$CORE_PATH/framework/include/core",
    "$CORE_PATH/framework/include/osal",
    "$CORE_PATH/adapter/uhdf/posix/include",
    "$CORE_PATH/framework/include/utils",
    "$CORE_PATH/framework/include",
    "$CORE_PATH/framework/test/unittest/include",
    "$CORE_PATH/framework/test/unittest/osal",
    "$BASE_ROOT_PATH/base/hiviewdfx/hilog_lite/interfaces/native/innerkits",
  ]

  defines = [ "__USER__" ]
  sources = [
    "$CORE_PATH/framework/support/posix/test/unittest/common/hdf_osal_test_posix.cpp",
    "$CORE_PATH/framework/test/unittest/osal/osal_all_test.c",
    "$CORE_PATH/framework/test/unittest/osal/osal_get_case_test.c",
    "$CORE_PATH/framework/test/unittest/osal/osal_list_test.c",
  ]
  deps = [
    "$BASE_ROOT_PATH/base/hiviewdfx/hilog_lite/frameworks/featured:hilog_shared",
    "$CORE_PATH/adapter/uhdf/manager:hdf_core",
    "$CORE_PATH/adapter/uhdf/posix:hdf_posix_osal",
  ]
  public_deps = [ "$BASE_ROOT_PATH/third_party/bounds_checking_function:libsec_shared" ]
}
