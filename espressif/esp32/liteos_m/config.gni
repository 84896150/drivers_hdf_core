# Kernel type, e.g. "linux", "liteos_a", "liteos_m".
kernel_type = "liteos_m"

# Kernel version.
kernel_version = "3.0.0"

# Board CPU type, e.g. "cortex-a7", "riscv32".
board_cpu = ""

# Board arch, e.g.  "armv7-a", "rv32imac".
board_arch = "rv32imac"

# Board, e.g.  "esp32".
board = "esp32"

# Toolchain name used for system compiling.
# E.g. gcc-arm-none-eabi, arm-linux-harmonyeabi-gcc, ohos-clang,  riscv32-unknown-elf.
# Note: The default toolchain is "ohos-clang". It's not mandatory if you use the default toochain.
board_toolchain = "riscv32-esp-elf"

# The toolchain path instatlled, it's not mandatory if you have added toolchian path to your ~/.bashrc.
board_toolchain_path = ""

# Compiler prefix.
board_toolchain_prefix = "riscv32-esp-elf-"

# Compiler type, "gcc" or "clang".
board_toolchain_type = "gcc"

# Board related common compile flags.
board_cflags = [
  #"-mlongcalls",
  "-O0",
  "-g",
  "-Wall",
  "-Wextra",
  "-fno-common",
  "-Wdouble-promotion",
  "-Wconversion",
  #"-mtext-section-literals",
  "-DESP32",
  "-Wno-implicit-function-declaration",
  "-Wno-sign-conversion",
  "-Wno-sign-compare",
  "-W",
  "-Wshadow",
  "-ffunction-sections",
  "-fdata-sections",
  "-Wno-conversion",
  "-Wno-unused-parameter",
  "-Wno-unused-variable",
  "-Wno-type-limits",
  "-Wno-cast-function-type",
  "-Wno-implicit-fallthrough",
  "-Wno-parentheses",
  "-Wformat=0",
]

board_cxx_flags = board_cflags

board_ld_flags = []

# Board related headfiles search path.
board_include_dirs = [
  "${ohos_root_path}device/espressif/esp32",
  "${ohos_root_path}device/qemu/riscv32_virt/fs",
  "${ohos_root_path}utils/native/base/include",
  "${ohos_root_path}kernel/liteos_m/utils",
  "${ohos_root_path}kernel/liteos_m/kal/cmsis",
  "${ohos_root_path}kernel/liteos_m/targets/esp32",
  "${ohos_root_path}kernel/liteos_m/targets/esp32/include",
  "${ohos_root_path}kernel/liteos_m/targets/esp32/include/asm",
  "${ohos_root_path}kernel/liteos_m/kernel/arch/risc-v/riscv32/gcc",
  "${ohos_root_path}kernel/liteos_m/kernel/arch/risc-v/riscv32/gcc/asm", 
  "${ohos_root_path}base/security/huks/interfaces/innerkits/huks_lite",
  "${ohos_root_path}base/security/interfaces/innerkits/huks_lite",
  "${ohos_root_path}utils/native/lite/include",
  "${ohos_root_path}device/espressif/esp32/sdk_liteos/esp-idf/components/log/include",
  "${ohos_root_path}device/espressif/esp32/sdk_liteos/esp-idf/components/mdns/test_afl_fuzz_host",
  "${ohos_root_path}device/espressif/esp32/sdk_liteos/esp-idf/components/esp_rom/include",
  "${ohos_root_path}device/espressif/esp32/sdk_liteos/esp-idf/components/soc/esp32c3/include",
  "${ohos_root_path}kernel/liteos_m/kernel/include"
]

# Board adapter dir for OHOS components.
board_adapter_dir = "esp32"

# Sysroot path.
board_configed_sysroot = ""

# Board storage type, it used for file system generation.
storage_type = ""

board_opt_flags = [ "-O2" ]
board_asmflags = [
  "-march=rv32imac",
  "-mabi=ilp32",
  "-static",
]
board_asmflags += board_opt_flags
