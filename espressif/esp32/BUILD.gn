import("//build/lite/config/component/lite_component.gni")
import("//device/espressif/esp32/config.gni")

group("esp32") {
}

build_ext_component("esp32_target") {
  exec_path = rebase_path(".", root_build_dir)
  command = "./build.sh "

  deps = [ 
    "//build/lite:ohos",
    "//kernel/liteos_m/targets/esp32:esp32_board",
    "//drivers/adapter/khdf/liteos_m:hdf_lite",
    "//device/espressif/esp32/drivers:platform_drivers",
    "//device/espressif/esp32/hdf_config:hdf_config",
  ]

  if (hdf_test_case) {
    deps += ["//device/espressif/esp32/test:hdf_test_drivers"]
  }
}
